# ==============================================================================
# Eco Class (Sustainable Class) - Environment Configuration
# ==============================================================================

# --- SUPABASE CONFIGURATION ---
# Public URL of your Supabase instance (cloud or local docker)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (safe for browser client-side auth & realtime subscriptions)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (STRICTLY SERVER-SIDE ONLY - bypasses RLS for system workers)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Direct Postgres Connection URI (used for migrations, pgvector, pg_cron)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- MQTT BROKER CONFIGURATION ---
# Broker URI (e.g., mqtt://localhost:1883, mqtts://broker.hivemq.com:8883)
# Leave empty or set to 'internal' to use the built-in resilient in-memory broker
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=eco_class_backend_srv
MQTT_USERNAME=eco_class_admin
MQTT_PASSWORD=eco_class_mqtt_secret_token

# --- AI ASSISTANT (ANTHROPIC CLAUDE) ---
# Server-side tool calling and explainable reasoning
ANTHROPIC_API_KEY=sk-ant-api03-placeholder-key-for-claude

# --- FACE RECOGNITION SERVICE (PYTHON FASTAPI) ---
# Endpoint to the microservice storing embeddings in pgvector
FACE_SERVICE_URL=http://localhost:8000
FACE_SERVICE_API_KEY=eco_class_face_service_secret_2026

# --- MULTI-CHANNEL NOTIFICATIONS ---
# Email Provider: 'resend', 'smtp', or 'mock'
EMAIL_PROVIDER=mock
RESEND_API_KEY=re_placeholder_123456789
EMAIL_FROM=alerts@ecoclass.campus.edu
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=campus-alerts@ecoclass.edu
SMTP_PASS=app_password_here

# SMS Provider: 'twilio' or 'mock'
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=AC_placeholder_sid
TWILIO_AUTH_TOKEN=placeholder_auth_token
TWILIO_FROM_NUMBER=+15551234567

# Web Push Notification (VAPID Keys)
VAPID_PUBLIC_KEY=placeholder_vapid_public_key
VAPID_PRIVATE_KEY=placeholder_vapid_private_key
VAPID_SUBJECT=mailto:admin@ecoclass.campus.edu

# --- APPLICATION & ENGINE SETTINGS ---
NODE_ENV=development
AUTOMATION_TICK_INTERVAL_MS=5000
IDLE_GRACE_PERIOD_MINUTES=5
SAFETY_MIN_LUX_PERCENT=10
DEFAULT_TARGET_LUX=400
CO2_FACTOR_KG_PER_KWH=0.82
ELECTRICITY_COST_PER_KWH=0.15
